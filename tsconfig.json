{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.geolib.json" }
  ],
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "es2015"],
